{
  "manifest_version": 3,
  "name": "PEDAIA — AI Instructional Design Studio",
  "version": "1.0.0",
  "description": "AI-Powered Instructional Design Studio for teachers, professors, and curriculum designers. Design lessons, Bloom's questions, activities, and push to Canvas or Google Classroom.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PEDAIA Instructional Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pedaia-studio@pedaia.ai",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open PEDAIA Companion Popup"
    },
    "open_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Toggle PEDAIA Side Panel alongside LMS or web"
    }
  }
}
